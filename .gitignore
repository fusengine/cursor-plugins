# Dependencies — regenerated by the installer (`bun install`), never fetched from git.
node_modules/

# Secrets and local environment
.env
.env.*
!.env.example

# Logs and caches
*.log
npm-debug.log*
.cache/
.eslintcache
*.tsbuildinfo

# Coverage
coverage/

# OS noise
.DS_Store

# Agent scratch state — session-local, not part of the distributed plugin
.harness/
.impeccable/
.codex/apex/
.claude/

# bun.lock IS committed on purpose (bun docs: "Should it be committed to git? Yes."),
# so `--frozen-lockfile` installs stay reproducible. Do not add it here.

{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "./scripts/hook.sh changelog",
        "matcher": "WebFetch|WebSearch"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/hook.sh changelog",
        "matcher": "MCP:(web_search_exa|get_code_context_exa|deep_researcher_start|deep_researcher_check)"
      }
    ]
  }
}

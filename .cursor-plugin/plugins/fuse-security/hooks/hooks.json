{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "./scripts/hook.sh security",
        "matcher": "Write"
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.sh security",
        "matcher": "Read"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "./scripts/hook.sh security",
        "matcher": "MCP:(resolve-library-id|query-docs|web_search_exa|get_code_context_exa|deep_researcher_start|deep_researcher_check)"
      }
    ]
  }
}

{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "./scripts/hook.sh aipilot"
      }
    ],
    "subagentStop": [
      {
        "command": "./scripts/hook.sh aipilot"
      }
    ],
    "sessionEnd": [
      {
        "command": "./scripts/hook.sh aipilot"
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/hook.sh",
        "matcher": "Task"
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.sh aipilot",
        "matcher": "Write"
      }
    ],
    "beforeMCPExecution": [
      {
        "matcher": "MCP:(query-docs|resolve-library-id|web_search_exa|get_code_context_exa)",
        "command": "./scripts/hook.sh aipilot",
        "failClosed": false
      }
    ]
  }
}

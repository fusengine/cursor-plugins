{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "./scripts/hook.sh aipilot"
      }
    ],
    "subagentStop": [
      {
        "command": "./scripts/hook.sh aipilot"
      }
    ],
    "sessionEnd": [
      {
        "command": "./scripts/hook.sh aipilot"
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/hook.sh",
        "matcher": "Task"
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.sh aipilot",
        "matcher": "Write"
      }
    ]
  }
}

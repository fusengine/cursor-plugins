{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/hook.sh lessons"
      }
    ],
    "sessionStart": [
      {
        "command": "./scripts/hook.sh lessons"
      }
    ],
    "subagentStart": [
      {
        "command": "./scripts/hook.sh lessons"
      }
    ],
    "stop": [
      {
        "command": "./scripts/hook.sh lessons"
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/hook.sh lessons",
        "matcher": "Write"
      }
    ]
  }
}
